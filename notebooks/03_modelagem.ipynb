        "# --- Definindo as transformações de pré-processamento primeiro ---\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "continuous_cols = [\"CNT_CHILDREN\", \"AMT_INCOME_TOTAL\", \"CNT_FAM_MEMBERS\", \"YEARS_BIRTH\", \"YEARS_EMPLOYED\" , \"INCOME_PER_PERSON\", \"HAS_CHILDREN\"]\n",
        "n_continuous = len(continuous_cols)\n",
        "\n",
        "categorical_mask = [False] * n_continuous + [True] * (X.shape[1] - n_continuous)\n",
        "\n",
        "preprocessor = ColumnTransformer(\n",
        "    [(\"num\", StandardScaler(), continuous_cols)],\n",
        "    remainder=\"passthrough\",\n",
        "    verbose_feature_names_out=False,\n",
        ")\n",
        "preprocessor.set_output(transform=\"pandas\")"
      ]
    },
